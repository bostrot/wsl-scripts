#####################################################
# @name: opencode
# @description: OpenCode AI coding agent CLI on PATH. Run `opencode` for the TUI, or `opencode web --port 4096` for the browser UI
# @version: 1.0.0
# @author: bostrot
# @license: MIT
# @git: https://github.com/bostrot/wsl-scripts
# @distro: Debian, Ubuntu, Alpine, Fedora, Arch
#####################################################
# Installs the OpenCode CLI (https://opencode.ai). The upstream installer
# hardcodes $HOME/.opencode/bin and puts it on PATH by appending an export to
# a shell rc file — which a non-interactive shell never reads, so anything
# driving this distro from outside would still not find the binary. Hence
# --no-modify-path plus a symlink into /usr/local/bin, which every shell has.
# Idempotent: re-running upgrades in place and refreshes the symlink.

# The installer is a bash script and downloads a tarball, so all three have to
# be there first — Alpine in particular ships no bash at all.
missing=""
for tool in bash curl tar; do
    command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
done
# $missing stays unquoted below on purpose: it is a list of package names.
if [ -n "$missing" ]; then
    if command -v apt-get >/dev/null 2>&1; then
        apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $missing
    elif command -v apk >/dev/null 2>&1; then
        apk add --no-cache $missing
    elif command -v dnf >/dev/null 2>&1; then
        dnf install -y -q $missing
    elif command -v pacman >/dev/null 2>&1; then
        pacman -Sy --noconfirm $missing
    else
        echo "No supported package manager found (apt/apk/dnf/pacman) to install:$missing"
        exit 1
    fi
fi

# Downloaded to a file rather than piped straight into bash: `curl ... | bash`
# exits 0 even when curl never resolved the host, so a dead download would
# report a successful install of nothing at all.
curl -fsSL https://opencode.ai/install -o /tmp/opencode-install.sh || {
    echo "Could not download the OpenCode installer."
    exit 1
}
if [ ! -s /tmp/opencode-install.sh ]; then
    echo "The downloaded OpenCode installer is empty."
    rm -f /tmp/opencode-install.sh
    exit 1
fi
# SHELL is defaulted because the installer reads `basename "$SHELL"`
# unconditionally, under `set -u`, above the block --no-modify-path turns
# off — an environment without that variable would abort it right there.
SHELL="${SHELL:-/bin/bash}" bash /tmp/opencode-install.sh --no-modify-path
rc=$?
rm -f /tmp/opencode-install.sh
if [ "$rc" -ne 0 ]; then
    echo "The OpenCode installer exited $rc."
    exit 1
fi

if [ ! -x "$HOME/.opencode/bin/opencode" ]; then
    echo "The installer finished but $HOME/.opencode/bin/opencode is missing."
    exit 1
fi
mkdir -p /usr/local/bin
ln -sf "$HOME/.opencode/bin/opencode" /usr/local/bin/opencode
hash -r 2>/dev/null || true

version=$(opencode --version 2>/dev/null)
if [ -z "$version" ]; then
    echo "opencode is on PATH but would not run."
    exit 1
fi
echo "OpenCode $version is installed. Add a provider with 'opencode auth login', then run 'opencode' for the TUI or 'opencode web --port 4096' for the browser UI on port 4096."
echo "The web server is unauthenticated: set OPENCODE_SERVER_PASSWORD before binding it to anything but localhost."
